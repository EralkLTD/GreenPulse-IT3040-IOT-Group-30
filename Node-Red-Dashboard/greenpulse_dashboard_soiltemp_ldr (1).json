  {
    "id": "gp_test_sensor",
    "type": "inject",
    "z": "gp_tab",
    "name": "TEST Sensor Data",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "greenpulse/sensor/data",
    "payload": "{\"soil_moisture\":62,\"temperature\":27.4,\"humidity\":71,\"soil_temperature\":24.8,\"light\":\"LIGHT\"}",
    "payloadType": "json",
    "x": 150,
    "y": 180,
    "wires": [
      [
        "gp_sensor_process"
      ]
    ]
  },
  {
    "id": "gp_sensor_process",
    "type": "function",
    "z": "gp_tab",
    "name": "Process Sensor Data",
    "func": "const d = msg.payload;\nif (!d || typeof d !== 'object') return null;\nconst now = new Date().toLocaleTimeString();\nconst soil = Number(d.soil_moisture);\nconst temp = Number(d.temperature);\nconst hum = Number(d.humidity);\nconst soilTemp = Number(d.soil_temperature);\n\nlet lightRaw = d.light;\nlet isLight;\nif (typeof lightRaw === 'string') {\n    const s = lightRaw.trim().toUpperCase();\n    isLight = ['LIGHT','BRIGHT','ON','1','TRUE'].includes(s);\n} else if (typeof lightRaw === 'boolean') {\n    isLight = lightRaw;\n} else {\n    isLight = Number(lightRaw) >= 500;\n}\nconst lightStatus = isLight ? '☀️ LIGHT' : '🌙 DARK';\n\nlet messages = [];\nif (soil < 30) messages.push('💧 Soil is dry — watering recommended');\nelse if (soil < 50) messages.push('🌱 Soil moisture is moderate — monitor plant');\nelse messages.push('✅ Soil moisture is sufficient');\n\nif (!Number.isNaN(soilTemp)) {\n    if (soilTemp < 18) messages.push('❄️ Soil temperature is low');\n    else if (soilTemp > 30) messages.push('🔥 Soil temperature is high');\n    else messages.push('🌡️ Soil temperature is in the dashboard target range');\n}\nmessages.push(isLight ? '☀️ Greenhouse condition: Light' : '🌙 Greenhouse condition: Dark');\n\nconst care = messages.join('\\n');\nconst input = JSON.stringify(d, null, 2);\nconst log = `sensor/data    ${now}    ${JSON.stringify(d)}`;\nreturn [\n {payload:soil},{payload:temp},{payload:hum},{payload:soilTemp},{payload:lightStatus},\n {payload:'🟢 Online'},{payload:now},{payload:care},{payload:input},{payload:log}\n];",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 180,
    "wires": [
      [
        "gp_gauge_soil"
      ],
      [
        "gp_gauge_temp"
      ],
      [
        "gp_gauge_hum"
      ],
      [
        "gp_gauge_soil_temp"
      ],
      [
        "gp_ldr_status"
      ],
      [
        "gp_status_device"
      ],
      [
        "gp_status_time"
      ],
      [
        "gp_care_text"
      ],
      [
        "gp_llm_input"
      ],
      [
        "gp_log_text"
      ]
    ]
  },
