  {
    "id": "gp_llm_process",
    "type": "function",
    "z": "gp_tab",
    "name": "Process LLM Output",
    "func": "const d = msg.payload;\nconst now = new Date().toLocaleTimeString();\nconst recommendation = (d && typeof d === 'object') ? (d.recommendation || JSON.stringify(d)) : String(d);\nconst log = `llm/care       ${now}    ${JSON.stringify(d)}`;\nreturn [{payload: recommendation},{payload: log}];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 300,
    "wires": [
      [
        "gp_llm_output"
      ],
      [
        "gp_log_text"
      ]
    ]
  },
