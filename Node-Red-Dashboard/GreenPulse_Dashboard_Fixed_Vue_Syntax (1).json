  {
    "id": "gp_norm_final",
    "type": "function",
    "z": "gp_tab_final",
    "name": "Normalize MQTT Payload",
    "func": "// Accept both HiveMQ auto-detected objects and JSON strings.\nif (typeof msg.payload === \"string\") {\n    const text = msg.payload.trim();\n    if (text.startsWith(\"{\") || text.startsWith(\"[\")) {\n        try { msg.payload = JSON.parse(text); }\n        catch (e) {\n            node.warn(\"Invalid JSON on \" + (msg.topic || \"unknown\") + \": \" + e.message);\n            return null;\n        }\n    }\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 175,
    "wires": [
      [
        "gp_state_final",
        "gp_debug_final"
      ]
    ]
  },
  {
    "id": "gp_debug_final",
    "type": "debug",
    "z": "gp_tab_final",
    "name": "MQTT Data Debug",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
