    "wires": []
  },
  {
    "id": "gp_state_final",
    "type": "function",
    "z": "gp_tab_final",
    "name": "Normalize and Persist Dashboard State",
    "func": "// Store telemetry arrival time independently of any status message.\nconst topic=String(msg.topic||'');\nlet s=flow.get('gp_dashboard_state')||{telemetry:null,profile:null,ai:null,status:null,location:null,settings:null,notifications:[],notificationStatus:null,updatedAt:null};\nif(topic==='greenpulse/dashboard/mqtt'){\n  s.mqtt=String(msg.payload||'UNKNOWN').toUpperCase();\n  flow.set('gp_dashboard_state',s);return {topic:'gp/state',payload:s};\n}\nlet p=msg.payload;\nif(typeof p==='string'){\n  const v=p.trim();\n  try {p=JSON.parse(v)} catch(e) {p=v}\n}\nif(topic==='greenpulse/device01/telemetry'){\n  if(!p||typeof p!=='object'||Array.isArray(p)||p.device_id!=='device01')return null;\n  s.telemetry=p;\n  s.updatedAt=Date.now();\n  s.lastTelemetry=new Date().toISOString();\n}else if(topic==='greenpulse/device01/status'){\n  // Accept {status:'ONLINE'}, {state:'ONLINE'}, or plain ONLINE.\n  const raw=(p&&typeof p==='object')?(p.status||p.state||'UNKNOWN'):p;\n  s.status={status:String(raw||'UNKNOWN').toUpperCase(),receivedAt:Date.now()};\n}else if(topic==='greenpulse/device01/profile'&&p&&typeof p==='object')s.profile=p;\nelse if(topic==='greenpulse/device01/ai'&&p&&typeof p==='object')s.ai=p;\nelse if(topic==='greenpulse/device01/location/resolved'&&p&&typeof p==='object')s.location=p;\nelse if(topic==='greenpulse/device01/notification/settings/state'&&p&&typeof p==='object'){\n  s.settings=p;\n  if(Array.isArray(p.recent_notifications)){\n    if(!Array.isArray(s.notifications)) s.notifications=[];\n    p.recent_notifications.forEach(n=>{\n      if(n&&n.notification_id&&!s.notifications.some(existing=>existing.notification_id===n.notification_id)){\n        s.notifications.push(n);\n      }\n    });\n    s.notifications=s.notifications.slice(0,40);\n  }\n}\nelse if(topic==='greenpulse/device01/notification/status'&&p&&typeof p==='object')s.notificationStatus=p;\nelse if(topic==='greenpulse/device01/notifications'&&p&&typeof p==='object'){\n  if(!Array.isArray(s.notifications))s.notifications=[];\n  if(p.notification_id&&!s.notifications.some(n=>n.notification_id===p.notification_id))s.notifications.unshift(p);\n  s.notifications=s.notifications.slice(0,40);\n}\nelse if(topic==='greenpulse/dashboard/init'){}\nelse return null;\nflow.set('gp_dashboard_state',s);\nreturn {topic:'gp/state',payload:s};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 190,
    "wires": [
      [
        "gp_ui_final"
      ]
    ]
