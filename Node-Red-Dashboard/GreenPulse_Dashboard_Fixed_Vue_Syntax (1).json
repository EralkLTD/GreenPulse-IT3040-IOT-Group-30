  {
    "id": "gp_ui_final",
    "type": "ui-template",
    "z": "gp_tab_final",
    "group": "gp_group_final",
    "page": "",
    "ui": "",
    "name": "GreenPulse Dashboard — Location + Notifications",
    "order": 1,
    "width": "12",
    "height": "18",
    "head": "",
    "format": "<template>\n<div class=\"gp-shell\">\n <header class=\"gp-header\"><div><div class=\"gp-eyebrow\">GREENPULSE · IOT MONITORING</div><h1>Smart Greenhouse <span>Control Center</span></h1><p>Live sensor intelligence · Crop management · Weather · Smart notifications</p></div><div class=\"gp-live\" :class=\"deviceOnline?'online':'offline'\"><span class=\"gp-dot\"></span>{{deviceLabel}}</div></header>\n <div class=\"gp-section-title\">Live Environment <span>{{lastSeen}}</span></div>\n <div class=\"gp-grid gp-metrics\">\n  <div class=\"gp-card gp-metric\" v-for=\"m in metrics\" :key=\"m.key\"><div class=\"gp-metric-label\">{{m.icon}} {{m.title}}</div><div class=\"gp-reading\">{{valueText(m) }} <small>{{m.unit}}</small></div><div class=\"gp-meter\"><div class=\"gp-fill\" :style=\"{width:barWidth(m)+'%',background:metricColor(m)}\"></div></div><div class=\"gp-hint\">{{rangeText(m)}} <span :style=\"{color:metricColor(m)}\">{{metricState(m)}}</span></div></div>\n  <div class=\"gp-card gp-metric\"><div class=\"gp-metric-label\">☀️ LIGHT LEVEL</div><div class=\"gp-reading gp-light\">{{telemetry?.light==='BRIGHT'?'☀️ BRIGHT':telemetry?.light==='DARK'?'🌙 DARK':'—'}}</div><div class=\"gp-hint\">Preferred: {{profile?.light_preference||'—'}}</div></div>\n </div>\n <div class=\"gp-grid gp-main\">\n  <section class=\"gp-card\"><h2>🌱 Crop Management</h2><label class=\"gp-label\">Active greenhouse plant</label><div class=\"gp-row\"><select v-model=\"plantSelection\" class=\"gp-input\"><option value=\"\">Choose a plant...</option><option v-for=\"p in plants\" :key=\"p\" :value=\"p\">{{p}}</option></select><button class=\"gp-btn\" @click=\"setPlant\" :disabled=\"!plantSelection\">Apply</button></div><p class=\"gp-muted\">Confirmed plant: <b>{{profile?.plant||'Waiting for profile'}}</b></p><div class=\"gp-thresholds\" v-if=\"profile\"><div v-for=\"m in metrics\" :key=\"m.key\"><span>{{m.title}}</span><b>{{rangeText(m)}}</b></div><div><span>Light preference</span><b>{{profile.light_preference||'—'}}</b></div></div><p v-else class=\"gp-empty\">Waiting for retained plant profile...</p></section>\n  <section class=\"gp-card\"><h2>🌍 Worldwide Greenhouse Location</h2><label class=\"gp-label\">Search a city or town</label><div class=\"gp-search\"><input class=\"gp-input\" v-model=\"locationQuery\" @input=\"searchLocation\" @keydown.down.prevent=\"moveSuggestion(1)\" @keydown.up.prevent=\"moveSuggestion(-1)\" @keydown.enter.prevent=\"chooseHighlighted\" placeholder=\"Try Colombo, London, Tokyo...\" autocomplete=\"off\"/><span v-if=\"searching\" class=\"gp-spin\">◌</span></div><div v-if=\"suggestions.length\" class=\"gp-suggestions\"><button v-for=\"(s,i) in suggestions\" :key=\"s.id||i\" class=\"gp-suggestion\" :class=\"{highlighted:i===highlighted}\" @click=\"selectLocation(s)\"><b>{{s.name}}</b><small>{{[s.admin1,s.country].filter(Boolean).join(', ')}} · {{s.country_code||''}}</small></button></div><p class=\"gp-muted\" v-if=\"locationError\">{{locationError}}</p><div class=\"gp-selected\" v-if=\"location\"><b>📍 {{location.location_name}}</b><span>{{[location.admin1,location.country].filter(Boolean).join(', ')}}</span><small v-if=\"location.latitude!=null\">{{Number(location.latitude).toFixed(4)}}°, {{Number(location.longitude).toFixed(4)}}°</small><small>Confirmed by backend</small></div><p class=\"gp-muted\" v-else>No location confirmed yet.</p></section>\n </div>\n <div class=\"gp-grid gp-main\">\n  <section class=\"gp-card\"><h2>✨ Gemini Care Intelligence <span class=\"gp-priority\" :class=\"(ai?.priority||'').toLowerCase()\">{{ai?.priority||'AWAITING AI'}}</span></h2><blockquote class=\"gp-quote\">{{ai?.care_quote||'Waiting for AI care analysis...'}}</blockquote><h3>Condition summary</h3><p>{{ai?.condition_summary||'No analysis yet.'}}</p><h3>Recommended care</h3><p>{{ai?.care_tip||'Care recommendations will appear here.'}}</p><h3>Weather insight</h3><p>{{ai?.weather_summary||'Weather analysis pending.'}}</p><h3>Relevant email alerts</h3><p>{{ai?.alert_summary||'No summarized incoming alerts yet.'}}</p></section>\n  <section class=\"gp-card\"><h2>✉️ Notification Center</h2><div class=\"gp-tabs\"><button :class=\"{active:tab==='recipients'}\" @click=\"tab='recipients'\">Recipients</button><button :class=\"{active:tab==='alerts'}\" @click=\"tab='alerts'\">Recent Alerts <span>{{notifications.length}}</span></button></div><div v-if=\"tab==='recipients'\"><label class=\"gp-label\">Recipient email</label><div class=\"gp-row\"><input class=\"gp-input\" v-model=\"recipientEmail\" type=\"email\" placeholder=\"farmer@example.com\"/><button class=\"gp-btn\" @click=\"addRecipient\">+ Add</button></div><div class=\"gp-checks\"><label v-for=\"c in categories\" :key=\"c.key\"><input type=\"checkbox\" v-model=\"preferences[c.key]\"/> {{c.label}}</label></div><p class=\"gp-muted\">Preferences apply to newly added recipients. Backend confirmation is required.</p><div v-if=\"recipients.length\" class=\"gp-recipient\" v-for=\"r in recipients\" :key=\"r.email||r.id\"><div><b>{{r.email_masked||r.email||'Recipient'}}</b><small>{{r.enabled===false?'Disabled':'Enabled'}}</small></div><div class=\"gp-row\"><button class=\"gp-btn-secondary\" v-if=\"r.email\" @click=\"recipientAction('SEND_TEST_EMAIL',r.email)\">Send Test</button><button class=\"gp-btn-secondary\" v-if=\"r.email\" @click=\"recipientAction('REMOVE_RECIPIENT',r.email)\">Remove</button></div></div><button class=\"gp-btn-secondary gp-refresh\" @click=\"send({payload:{action:'GET_STATE'}})\">Refresh Settings</button></div><div v-else><div v-for=\"n in notifications\" :key=\"n.notification_id\" class=\"gp-alert\"><div class=\"gp-row\"><b>{{n.title||n.type||'Notification'}}</b><span class=\"gp-priority\" :class=\"(n.priority||'info').toLowerCase()\">{{n.priority||'INFO'}}</span></div><p>{{n.summary||'No summary'}}</p><small>{{n.generated_at||''}} · {{n.email_status||'PENDING'}}</small></div><p v-if=\"!notifications.length\" class=\"gp-empty\">No notifications received yet. Historical alerts require a backend state response.</p></div><p v-if=\"notice\" class=\"gp-muted\">{{notice}}</p></section>\n </div>\n <footer class=\"gp-footer\">GreenPulse · Device device01 · MQTT/TLS · Node-RED Dashboard 2.0</footer>\n</div>\n</template>\n<script>\nexport default {\n data(){return {snapshot:{},plants:[\"Tomato\", \"Cherry Tomato\", \"Bell Pepper\", \"Chilli Pepper\", \"Cucumber\", \"Eggplant\", \"Zucchini\", \"Okra\", \"Green Bean\", \"Pea\", \"Strawberry\", \"Melon\", \"Watermelon\", \"Lettuce\", \"Spinach\", \"Kale\", \"Swiss Chard\", \"Arugula\", \"Pak Choi\", \"Cabbage\", \"Celery\", \"Basil\", \"Mint\", \"Coriander\", \"Parsley\", \"Dill\", \"Oregano\", \"Thyme\", \"Rosemary\", \"Sage\", \"Chives\", \"Radish\", \"Beetroot\", \"Carrot\", \"Spring Onion\", \"Broccoli\", \"Cauliflower\"],plantSelection:'',locationQuery:'',suggestions:[],searching:false,locationError:'',highlighted:0,searchTimer:null,searchController:null,tab:'recipients',recipientEmail:'',preferences:{enabled:true,watering_alerts:true,temperature_alerts:true,humidity_alerts:true,weather_alerts:true,system_alerts:true,daily_summary:true},notice:'',categories:[{key:'watering_alerts',label:'💧 Watering'},{key:'temperature_alerts',label:'🌡️ Temperature'},{key:'humidity_alerts',label:'💨 Humidity'},{key:'weather_alerts',label:'⛈️ Weather'},{key:'system_alerts',label:'🚨 System'},{key:'daily_summary',label:'📋 Daily'}],metrics:[{key:'air_temperature',title:'Air Temperature',unit:'°C',icon:'🌡️',max:50},{key:'humidity',title:'Humidity',unit:'%',icon:'💧',max:100},{key:'soil_moisture',title:'Soil Moisture',unit:'%',icon:'🌱',max:100},{key:'soil_temperature',title:'Soil Temperature',unit:'°C',icon:'🌡️',max:45}]}} ,\n computed:{telemetry(){return this.snapshot.telemetry||null},profile(){return this.snapshot.profile||null},ai(){const a=this.snapshot.ai;return a&&(!this.profile||!a.plant||a.plant===this.profile.plant)?a:null},location(){return this.snapshot.location||null},recipients(){return this.snapshot.settings?.recipients||[]},notifications(){return this.snapshot.notifications||[]},deviceOnline(){const status=this.snapshot.status;const raw=typeof status==='string'?status:(status?.status||status?.state||'');const flag=String(raw).toUpperCase();const last=Date.parse(this.snapshot.lastTelemetry||\"\");const recent=last>0&&(Date.now()-last<20000);return flag!=='OFFLINE'&&recent},deviceLabel(){const status=this.snapshot.status;const flag=String(typeof status==='string'?status:(status?.status||status?.state||'')).toUpperCase();if(flag==='OFFLINE')return 'DEVICE OFFLINE';if(this.deviceOnline)return 'DEVICE ONLINE';return this.snapshot.lastTelemetry?'DEVICE OFFLINE · NO TELEMETRY':'DEVICE STATUS UNKNOWN'},lastSeen(){return this.snapshot.lastTelemetry?'Last telemetry: '+new Date(this.snapshot.lastTelemetry).toLocaleTimeString():'Waiting for telemetry'}},\n watch:{msg:{deep:true,handler(v){if(v?.topic==='gp/state'&&v.payload){this.snapshot=v.payload;if(this.profile?.plant)this.plantSelection=this.profile.plant;if(this.location&&!this.locationQuery)this.locationQuery=[this.location.location_name,this.location.country].filter(Boolean).join(', ');}}}},\n mounted(){this.send({payload:{action:'REQUEST_STATE'}});this._refresh=setInterval(()=>this.$forceUpdate(),5000)},\n beforeUnmount(){clearTimeout(this.searchTimer);if(this.searchController)this.searchController.abort();clearInterval(this._refresh)},\n methods:{valueText(m){const v=this.telemetry?.[m.key];return typeof v==='number'&&Number.isFinite(v)?v.toFixed(1):'—'},barWidth(m){const v=Number(this.telemetry?.[m.key]);return Number.isFinite(v)&&this.telemetry?.[m.key]!=null?Math.max(0,Math.min(100,v/m.max*100)):0},range(m){return this.profile?.[m.key]},rangeText(m){const r=this.range(m);return r&&Number.isFinite(Number(r.min))&&Number.isFinite(Number(r.max))?`${r.min}–${r.max} ${m.unit}`:'Awaiting crop thresholds'},metricState(m){const v=this.telemetry?.[m.key],r=this.range(m);if(typeof v!=='number'||!r)return '—';return v<r.min?'LOW':v>r.max?'HIGH':'NORMAL'},metricColor(m){const s=this.metricState(m);return s==='NORMAL'?'#10b981':s==='HIGH'?'#fb7185':s==='LOW'?'#fbbf24':'#64748b'},setPlant(){if(this.plants.includes(this.plantSelection))this.send({payload:{action:'SET_PLANT',plant:this.plantSelection}})},moveSuggestion(d){if(this.suggestions.length)this.highlighted=(this.highlighted+d+this.suggestions.length)%this.suggestions.length},chooseHighlighted(){if(this.suggestions[this.highlighted])this.selectLocation(this.suggestions[this.highlighted])},searchLocation(){clearTimeout(this.searchTimer);if(this.searchController)this.searchController.abort();this.suggestions=[];this.highlighted=0;this.locationError='';const q=this.locationQuery.trim();if(q.length<3){this.searching=false;return}this.searchTimer=setTimeout(()=>this.fetchLocations(q),400)},async fetchLocations(q){this.searchController=new AbortController();this.searching=true;try{const url='https://geocoding-api.open-meteo.com/v1/search?name='+encodeURIComponent(q)+'&count=8&language=en&format=json';const res=await fetch(url,{signal:this.searchController.signal});if(!res.ok)throw new Error('Geocoding service unavailable');const data=await res.json();if(this.locationQuery.trim()!==q)return;this.suggestions=Array.isArray(data.results)?data.results:[];if(!this.suggestions.length)this.locationError='No matching locations found.'}catch(e){if(e.name!=='AbortError')this.locationError='Location search failed. Please retry.'}finally{if(this.locationQuery.trim()===q)this.searching=false}},selectLocation(s){if(!s.name||!s.country||!s.id)return;this.locationQuery=[s.name,s.admin1,s.country].filter(Boolean).join(', ');this.suggestions=[];this.send({payload:{action:'SET_LOCATION',location:{location_name:s.name,admin1:s.admin1||'',country:s.country,country_code:s.country_code||'',geocoding_id:s.id,latitude:s.latitude,longitude:s.longitude}}});this.notice='Location submitted. Waiting for backend confirmation.'},addRecipient(){const email=this.recipientEmail.trim();if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)){this.notice='Enter a valid email address.';return}this.send({payload:{action:'ADD_RECIPIENT',email,preferences:{...this.preferences}}});this.recipientEmail='';this.notice='Recipient request sent. Waiting for backend confirmation.'},recipientAction(action,email){this.send({payload:{action,email}});this.notice=action+' request sent.'}}\n}\n</script>\n<style>\n.gp-shell{color:#e2e8f0;font-family:Inter,ui-sans-serif,system-ui,sans-serif;padding:8px 3px 22px;max-width:1600px;margin:auto}.gp-header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:6px 0 24px;flex-wrap:wrap}.gp-eyebrow{font-size:11px;letter-spacing:2.5px;color:#34d399;font-weight:800}.gp-header h1{font-size:clamp(24px,3vw,35px);margin:7px 0;font-weight:800;line-height:1.15}.gp-header h1 span{color:#34d399}.gp-header p,.gp-muted{color:#94a3b8;font-size:13px}.gp-live{border:1px solid #475569;border-radius:50px;padding:10px 13px;font-size:11px;font-weight:800;letter-spacing:.4px;display:flex;gap:9px;align-items:center}.gp-live.online{color:#34d399;border-color:#065f46}.gp-live.offline{color:#fbbf24}.gp-dot{width:9px;height:9px;border-radius:50%;background:currentColor}.gp-section-title{display:flex;justify-content:space-between;align-items:center;font-size:16px;font-weight:750;margin-bottom:12px}.gp-section-title span{font-size:12px;font-weight:400;color:#94a3b8}.gp-grid{display:grid;gap:14px}.gp-metrics{grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:14px}.gp-main{grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:14px;align-items:stretch}.gp-card{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:20px;min-width:0;box-shadow:0 8px 24px #0206171c}.gp-card h2{font-size:16px;font-weight:750;margin:0 0 20px;display:flex;justify-content:space-between;align-items:center;gap:10px}.gp-card h3{font-size:12px;color:#34d399;margin:16px 0 5px}.gp-card p{font-size:13px;line-height:1.6}.gp-metric{padding:16px}.gp-metric-label{font-size:11px;color:#94a3b8;font-weight:700;letter-spacing:.4px}.gp-reading{font-size:clamp(22px,2.3vw,32px);font-weight:800;margin:16px 0 13px;white-space:nowrap}.gp-reading small{font-size:13px;font-weight:500;color:#94a3b8}.gp-light{font-size:18px}.gp-meter{height:7px;background:#334155;border-radius:10px;overflow:hidden}.gp-fill{height:100%;border-radius:10px;transition:width .3s}.gp-hint{display:flex;justify-content:space-between;gap:6px;font-size:10px;color:#94a3b8;margin-top:10px}.gp-label{display:block;font-size:12px;color:#cbd5e1;font-weight:600;margin:0 0 8px}.gp-row{display:flex;align-items:center;gap:8px;justify-content:space-between}.gp-input{background:#0f172a!important;color:#e2e8f0!important;border:1px solid #475569!important;border-radius:9px!important;padding:11px 12px!important;font-size:13px!important;outline:none!important;width:100%;min-width:0}.gp-input:focus{border-color:#10b981!important}.gp-btn{background:#10b981;color:#052e24;font-weight:800;border:0;border-radius:9px;padding:11px 15px;white-space:nowrap;cursor:pointer}.gp-btn:disabled{opacity:.5}.gp-btn-secondary{border:1px solid #475569;color:#e2e8f0;background:#334155;border-radius:8px;padding:8px 10px;font-size:11px;cursor:pointer}.gp-thresholds{margin-top:18px}.gp-thresholds>div{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #334155;font-size:12px}.gp-thresholds span{color:#94a3b8}.gp-thresholds b{color:#34d399}.gp-search{position:relative}.gp-spin{position:absolute;right:12px;top:10px;color:#34d399;font-size:20px}.gp-suggestions{border:1px solid #475569;background:#0f172a;border-radius:10px;margin-top:5px;max-height:265px;overflow-y:auto}.gp-suggestion{display:flex;flex-direction:column;width:100%;text-align:left;background:transparent;border:0;color:#e2e8f0;padding:10px 13px;border-bottom:1px solid #334155;cursor:pointer}.gp-suggestion:hover,.gp-suggestion.highlighted{background:#334155}.gp-suggestion small{color:#94a3b8;margin-top:3px}.gp-selected{display:flex;flex-direction:column;gap:5px;border:1px solid #065f46;background:#064e3b30;border-radius:10px;padding:12px;margin-top:14px}.gp-selected b{color:#6ee7b7}.gp-selected span,.gp-selected small{font-size:11px;color:#94a3b8}.gp-quote{border-left:3px solid #10b981;padding:9px 13px;background:#064e3b26;color:#d1fae5;margin:0 0 18px;font-style:italic;font-size:14px}.gp-priority{border-radius:20px;background:#334155;color:#cbd5e1;padding:5px 9px;font-size:10px;font-weight:800;white-space:nowrap}.gp-priority.high,.gp-priority.critical{background:#7f1d1d;color:#fecaca}.gp-priority.medium{background:#78350f;color:#fde68a}.gp-priority.low,.gp-priority.info{background:#064e3b;color:#6ee7b7}.gp-tabs{display:flex;gap:8px;border-bottom:1px solid #334155;margin-bottom:16px}.gp-tabs button{background:transparent;color:#94a3b8;border:0;padding:9px 12px;cursor:pointer;border-bottom:2px solid transparent}.gp-tabs button.active{color:#34d399;border-color:#10b981}.gp-checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:18px 0}.gp-checks label{font-size:12px}.gp-checks input{accent-color:#10b981}.gp-recipient{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid #334155;padding:12px 0}.gp-recipient small{display:block;color:#94a3b8;margin-top:4px}.gp-refresh{margin-top:12px}.gp-alert{padding:13px 0;border-bottom:1px solid #334155}.gp-alert p{margin:7px 0}.gp-alert small{color:#94a3b8}.gp-empty{color:#94a3b8;font-style:italic}.gp-footer{font-size:11px;color:#64748b;text-align:center;margin:18px 0}@media(max-width:1100px){.gp-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.gp-main{grid-template-columns:1fr}.gp-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.gp-card{padding:15px}}@media(max-width:400px){.gp-metrics{grid-template-columns:1fr}.gp-row{flex-wrap:wrap}.gp-btn{width:100%}}\n</style>",
