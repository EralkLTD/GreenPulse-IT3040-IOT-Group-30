    "func": "const p=msg.payload||{};\nif(!p || typeof p!=='object')return null;\nconst action=String(p.action||'');\nif(action==='REQUEST_STATE')return [null,{topic:'gp/state',payload:flow.get('gp_dashboard_state')||{}}];\nlet topic=null,body=null,qos='1';\nif(action==='SET_PLANT'){\n  if(typeof p.plant!=='string'||!p.plant.trim())return null;\n  topic='greenpulse/device01/config';body={plant_type:p.plant.trim()};qos='0';\n}else if(action==='SET_LOCATION'){\n  const loc=p.location;\n  if(!loc||!Number.isFinite(Number(loc.latitude))||!Number.isFinite(Number(loc.longitude))||!loc.location_name||!loc.country||!loc.geocoding_id)return null;\n  if(Number(loc.latitude)===0&&Number(loc.longitude)===0)return null;\n  topic='greenpulse/device01/location';body={device_id:'device01',...loc};\n}else if(['ADD_RECIPIENT','REMOVE_RECIPIENT','SEND_TEST_EMAIL','GET_STATE','UPDATE_RECIPIENT'].includes(action)){\n  topic='greenpulse/device01/notification/settings';body={...p,request_id:p.request_id||('nr-'+Date.now()+'-'+Math.random().toString(36).slice(2,8))};\n}else return null;\nreturn [{topic,payload:JSON.stringify(body),qos,retain:false},null];",
