[
  {
    "id": "gp_tab_main",
    "type": "tab",
    "label": "GreenPulse Greenhouse",
    "disabled": false,
    "info": "GreenPulse AI-Powered Smart Greenhouse System - Dashboard 2.0 Flow"
  },
  {
    "id": "gp_ui_base",
    "type": "ui-base",
    "name": "GreenPulse Dashboard",
    "path": "/dashboard",
    "includeClientData": true,
    "acceptsClientConfig": ["ui-theme"]
  },
  {
    "id": "gp_ui_theme",
    "type": "ui-theme",
    "name": "GreenPulse Dark Theme",
    "colors": {
      "surface": "#0f172a",
      "primary": "#10b981",
      "bgPage": "#020617",
      "groupBg": "#1e293b",
      "groupOutline": "#334155"
    }
  },
  {
    "id": "gp_ui_page",
    "type": "ui-page",
    "name": "Smart Greenhouse",
    "ui": "gp_ui_base",
    "path": "/greenhouse",
    "icon": "leaf",
    "theme": "gp_ui_theme",
    "order": 1
  },
  {
    "id": "gp_grp_location",
    "type": "ui-group",
    "name": "Worldwide Location Settings",
    "page": "gp_ui_page",
    "width": "6",
    "height": "8",
    "order": 1,
    "showTitle": false
  },
  {
    "id": "gp_grp_notifications",
    "type": "ui-group",
    "name": "Notification Center & Alerts",
    "page": "gp_ui_page",
    "width": "12",
    "height": "12",
    "order": 2,
    "showTitle": false
  },
  {
    "id": "gp_mqtt_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Cloud",
    "broker": "your-cluster-url.s1.eu.hivemq.cloud",
    "port": "8883",
    "tls": "gp_tls_config",
    "clientid": "greenpulse_nodered_dash",
    "autoConnect": true,
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "gp_tls_config",
    "type": "tls-config",
    "name": "HiveMQ TLS",
    "cert": "",
    "key": "",
    "ca": "",
    "servername": "",
    "verifyservercert": true
  },
  {
    "id": "gp_mqtt_in_loc_resolved",
    "type": "mqtt in",
    "z": "gp_tab_main",
    "name": "Location Resolved In",
    "topic": "greenpulse/device01/location/resolved",
    "qos": "1",
    "datatype": "json",
    "broker": "gp_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 140,
    "wires": [["gp_node_loc_template"]]
  },
  {
    "id": "gp_node_loc_template",
    "type": "ui-template",
    "z": "gp_tab_main",
    "group": "gp_grp_location",
    "name": "Location Autocomplete",
    "order": 1,
    "width": "6",
    "height": "8",
    "format": "<!-- PASTE CONTENTS OF nodered/location_autocomplete_template.html HERE -->",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "gp-loc-node",
    "x": 420,
    "y": 140,
    "wires": [["gp_mqtt_out_location"]]
  },
  {
    "id": "gp_mqtt_out_location",
    "type": "mqtt out",
    "z": "gp_tab_main",
    "name": "Publish Location",
    "topic": "greenpulse/device01/location",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "gp_mqtt_broker",
    "x": 680,
    "y": 140,
    "wires": []
  },
  {
    "id": "gp_mqtt_in_notif_state",
    "type": "mqtt in",
    "z": "gp_tab_main",
    "name": "Notification State In",
    "topic": "greenpulse/device01/notification/settings/state",
    "qos": "1",
    "datatype": "json",
    "broker": "gp_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 260,
    "wires": [["gp_node_notif_center"]]
  },
  {
    "id": "gp_mqtt_in_live_notifs",
    "type": "mqtt in",
    "z": "gp_tab_main",
    "name": "Live Notifications In",
    "topic": "greenpulse/device01/notifications",
    "qos": "1",
    "datatype": "json",
    "broker": "gp_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 320,
    "wires": [["gp_node_notif_center"]]
  },
  {
    "id": "gp_node_notif_center",
    "type": "ui-template",
    "z": "gp_tab_main",
    "group": "gp_grp_notifications",
    "name": "Notification Center",
    "order": 1,
    "width": "12",
    "height": "12",
    "format": "<!-- PASTE CONTENTS OF nodered/notification_center_template.html HERE -->",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "gp-notif-node",
    "x": 420,
    "y": 280,
    "wires": [["gp_mqtt_out_notif_settings"]]
  },
  {
    "id": "gp_mqtt_out_notif_settings",
    "type": "mqtt out",
    "z": "gp_tab_main",
    "name": "Publish Settings Command",
    "topic": "greenpulse/device01/notification/settings",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "gp_mqtt_broker",
    "x": 700,
    "y": 280,
    "wires": []
  }
]
